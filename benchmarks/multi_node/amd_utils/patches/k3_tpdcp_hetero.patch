+    kv_cache: "torch.Tensor | tuple | list",
+    spec: "KVCacheSpec | None" = None,
+) -> "tuple[torch.Tensor, torch.Tensor]":
+    """Return (conv_state, ssm_state) for a KDA/Mamba layer, version-robustly.
+
